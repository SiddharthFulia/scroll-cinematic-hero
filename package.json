{
  "name": "scroll-cinematic-hero",
  "version": "0.1.0",
  "description": "Drop-in React component that plays a scroll-driven WebP frame sequence as a sticky cinematic hero. Tiered render modes (full / mobile / fallback), DPR-aware canvas paint, ffmpeg extract-frames CLI.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "tsc -p tsconfig.lib.json && vite build --config vite.lib.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "extract-frames": "node scripts/extract-frames.mjs",
    "optimize-frames": "node scripts/optimize-frames.mjs"
  },
  "keywords": [
    "react",
    "scroll",
    "cinematic",
    "hero",
    "webp",
    "canvas",
    "frame-sequence",
    "apple-style",
    "ffmpeg",
    "siddharth-fulia"
  ],
  "author": "Siddharth Fulia <eng@getpassionfruit.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SiddharthFulia/scroll-cinematic-hero"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^14.1.0",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "jsdom": "^23.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.6.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
